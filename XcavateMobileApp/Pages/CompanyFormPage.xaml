<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate;assembly=PlutoFramework"
                       xmlns:form="clr-namespace:PlutoFramework.Components.Form;assembly=PlutoFramework"
                       xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons;assembly=PlutoFramework"
                       x:Class="XcavateMobileApp.Pages.CompanyFormPage"
                       Title="{Binding Title}">
    <template:PageTemplate.MainContent>
        <ScrollView>
            <VerticalStackLayout Margin="0, 45, 0, 0"
                                 Spacing="15"
                                 Padding="0, 20, 0, 200">
                <VerticalStackLayout Spacing="15"
                                     Margin="20,0,20,0"
                                     x:Name="verticalStackLayout">
                    <form:FormInputView Placeholder="Company name"
                                        CardWidth="{Binding Source={x:Reference verticalStackLayout}, Path=Width}"
                                        Text="{Binding CompanyName}" />

                    <form:FormInputView Placeholder="Email"
                                        CardWidth="{Binding Source={x:Reference verticalStackLayout}, Path=Width}"
                                        KeyboardType="Email"
                                        ValidateEmail="True"
                                        Text="{Binding Email}" />

                    <form:FormInputView Placeholder="Website"
                                        CardWidth="{Binding Source={x:Reference verticalStackLayout}, Path=Width}"
                                        KeyboardType="Url"
                                        Text="{Binding Website}" />

                    <form:FormLargeInputView Placeholder="Address"
                                             CardWidth="{Binding Source={x:Reference verticalStackLayout}, Path=Width}"
                                             Text="{Binding Address}" />

                    <form:FormLargeInputView Placeholder="Summary"
                                             CardWidth="{Binding Source={x:Reference verticalStackLayout}, Path=Width}"
                                             Text="{Binding Summary}" />

                    <form:FormImageUploadView Title="Company logo"
                                              ImageStream="{Binding LogoStream}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </template:PageTemplate.MainContent>

    <template:PageTemplate.PopupContent>
        <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 1, 1, 80"
                        AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional">
            <Grid AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 50"
                  AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                  ColumnSpacing="15"
                  Margin="20, 0, 20, 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <buttons:BasicGrayButton Text="Cancel"
                                         Command="{Binding CancelCommand}"
                                         Grid.Column="0" />

                <buttons:ElevatedButton Text="Save"
                                        Grid.Column="1"
                                        Command="{Binding SaveCommand}"
                                        ButtonState="{Binding SaveButtonState}" />
            </Grid>
        </AbsoluteLayout>
    </template:PageTemplate.PopupContent>
</template:PageTemplate>
