<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate;assembly=PlutoFramework"
                       xmlns:form="clr-namespace:PlutoFramework.Components.Form;assembly=PlutoFramework"
                       xmlns:card="clr-namespace:PlutoFramework.Components.Card;assembly=PlutoFramework"
                       x:Class="XcavateMobileApp.Pages.CompanyDetailPage"
                       Title="{Binding Title}"
                       NavigationBarExtra1Text="Edit"
                       NavigationBarExtra1Command="{Binding EditCommand}"
                       NavigationBarExtra2Text="Delete"
                       NavigationBarExtra2Command="{Binding DeleteCommand}">
    <template:PageTemplate.MainContent>
        <ScrollView>
            <VerticalStackLayout Margin="0, 45, 0, 0"
                                 Spacing="15"
                                 Padding="20, 20, 20, 200"
                                 IsVisible="{Binding ShowContent}">

                <card:Card CardPadding="0"
                           HeightRequest="160"
                           IsVisible="{Binding HasLogo}">
                    <card:Card.View>
                        <Image Source="{Binding LogoSource}"
                               Aspect="AspectFit"
                               Margin="10" />
                    </card:Card.View>
                </card:Card>

                <form:FormWideValueView Title="Company name"
                                        Value="{Binding CompanyName}" />

                <form:FormWideValueView Title="Email"
                                        Value="{Binding EmailText}" />

                <form:FormWideValueView Title="Website"
                                        Value="{Binding WebsiteText}"
                                        IsVisible="{Binding HasWebsite}" />

                <form:FormLargeValueView Title="Address"
                                         Value="{Binding AddressText}"
                                         IsVisible="{Binding HasAddress}" />

                <form:FormLargeValueView Title="Summary"
                                         Value="{Binding SummaryText}"
                                         IsVisible="{Binding HasSummary}" />

                <!-- Switching the selected company only makes sense from the second one on. -->
                <Label FontAttributes="Bold"
                       Text="Your companies"
                       HorizontalTextAlignment="Start"
                       IsVisible="{Binding HasMultipleCompanies}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Companies}"
                                     Spacing="10"
                                     IsVisible="{Binding HasMultipleCompanies}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <card:Card CardPadding="15, 0, 15, 0"
                                       HeightRequest="70">
                                <card:Card.View>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="4"
                                                             VerticalOptions="Center"
                                                             InputTransparent="True">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding EmailText}"
                                                   FontSize="13"
                                                   TextColor="#A6A6A6"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="Selected"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"
                                               InputTransparent="True"
                                               IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                </card:Card.View>

                                <card:ClickableCard.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type template:PageTemplate}}, Path=BindingContext.SelectCompanyCommand}"
                                                          CommandParameter="{Binding .}" />
                                </card:ClickableCard.GestureRecognizers>
                            </card:Card>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </template:PageTemplate.MainContent>
</template:PageTemplate>
