<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XcavateMobileApp.Pages.TermsDocumentPage"
             xmlns:templates="clr-namespace:PlutoFramework.Templates.TopNavigationBarTemplate;assembly=PlutoFramework"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#0a0a0a}"
             Shell.PresentationMode="NotAnimated"
             HideSoftInputOnTapped="True">

    <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                    AbsoluteLayout.LayoutFlags="All">

        <Grid AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
              AbsoluteLayout.LayoutFlags="All"
              Margin="0,65,0,0">
            <WebView x:Name="webView"
                     Navigating="OnNavigating"
                     Navigated="OnNavigated" />

            <ActivityIndicator x:Name="loadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               HeightRequest="40"
                               WidthRequest="40"
                               Color="{StaticResource Primary}" />

            <!-- The WebView's failure leaves a blank page; offer a readable error and a
                 retry instead. -->
            <VerticalStackLayout x:Name="errorView"
                                 IsVisible="False"
                                 Spacing="10"
                                 Padding="20"
                                 VerticalOptions="Center">
                <Label Text="The document could not be loaded."
                       FontAttributes="Bold"
                       FontSize="16"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                <Label Text="Check your connection and try again."
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#A6A6A6" />
                <Button Text="Try again"
                        Clicked="OnRetryClicked"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <templates:TopNavigationBarTemplate x:Name="topBar" />
    </AbsoluteLayout>
</ContentPage>
